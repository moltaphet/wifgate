# Deployed WifGate contract on Robinhood Chain
WIFGATE_ADDRESS=
# Wallet that receives the payments (98% of each; 2% is burned)
PAY_TO=
# At least 32 characters; identical on every instance:  openssl rand -hex 32
WIFGATE_SECRET=

# Optional
PORT=8787
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Browser origin of the web app (default "*": the API sets no cookies)
CORS_ORIGIN=
# Needed when you run more than one instance (Vercel, replicas) so a payment is redeemed exactly once
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
